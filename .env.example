# Copy to .env.local for local development, and add the same variable in
# Vercel → Project → Settings → Environment Variables for deployments.
#
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# This value is public by design (it ships to the browser); it is not a secret.
# Leave it unset to run Wattson without Google Drive (device storage only).
VITE_GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
